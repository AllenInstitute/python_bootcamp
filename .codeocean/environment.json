{
	"version": 1,
	"base_image": "codeocean/swdb:Python3.12code-server4.133",
	"post_install": true,
	"options": {
		"registry_host_arg": true,
		"git_ask_pass": true,
		"mount_secrets": true
	},
	"installers": {
		"mamba": {
			"packages": [
				{
					"name": "jupyterlab",
					"version": "4.6.3"
				},
				{
					"name": "libxml2",
					"version": "2.12.7"
				},
				{
					"name": "matplotlib",
					"version": "3.10.9"
				},
				{
					"name": "notebook",
					"version": "7.6.2"
				},
				{
					"name": "numpy",
					"version": "2.5.2"
				},
				{
					"name": "pandas",
					"version": "3.0.5"
				},
				{
					"name": "scikit-learn",
					"version": "1.9.0"
				},
				{
					"name": "scipy",
					"version": "1.18.0"
				},
				{
					"name": "seaborn",
					"version": "0.13.2"
